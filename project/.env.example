# Kopieren nach .env (wird nicht versioniert). Werte nur hier ändern, nicht im Code.

# LLM-Backend (OpenAI-kompatible Schnittstelle). Standard: lokales Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama

# Wechsel auf einen Cloud-Anbieter nur über diese drei Zeilen, z. B.:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<Modellname des Anbieters>
# LLM_API_KEY=<eigener Schlüssel, niemals committen>

# Ports (Docker Compose und lokale Starts)
MCP_PORT=8000
MOCK_API_PORT=8001
DASHBOARD_PORT=8080

# Optional: Rolle des MCP-Servers ab Lab 7.1 (viewer oder operator) und Server-Skript des Agent-Clients
# VANTRA_ROLE=viewer
# MCP_SERVER_SCRIPT=playground/server.py
# Optional: Streamable-HTTP-Adresse statt stdio (ab Modul 6), gilt für agent_client, script_client, second_client
# MCP_SERVER_URL=http://localhost:8000/mcp
